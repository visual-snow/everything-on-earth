{"slug":"tio-ikim-medical-image-deidentification","name":"MEDE","what_it_is":"A Python CLI and library for multi-step anonymization of medical imaging data: DICOM metadata deidentification, defacing, skull-stripping, OCR text removal, and interactive refinement. Also supports MRI raw data (twix) and whole slide images.","components":["CLI entry point","DICOM metadata engine","Defacing module","Skull-stripping module (GPU)","OCR text-removal module (EasyOCR)","Interactive refinement UI","twix anonymization","WSI anonymization","Multiprocessing workers"],"protocols":["DICOM","DICOM Confidentiality Profiles (PS 3.15)","twix MRI raw format"],"measurement":["Throughput benchmarked vs state-of-the-art"],"modes":["Metadata-only","Defacing","Skull-stripping","Text removal","Interactive refinement","twix mode","WSI mode","Combined mode"],"constraints":["GPU required for skull-stripping","EasyOCR/Tesseract dependency for text removal","Interactive mode needs GUI/display","Platform-specific Docker images (arm64/amd64)"],"docker_services":["morrempe/mede:amd64","morrempe/mede:arm64"],"notable_absences":["No audit log","No FHIR/HL7","No DICOM network (C-STORE/C-MOVE)","No test suite","No HIPAA/GDPR certification docs"],"configuration":[],"fault_injection":[]}