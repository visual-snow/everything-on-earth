{"slug":"novartis-ontobrowser","name":"OntoBrowser","what_it_is":"Java EE web application for collaborative curation and management of ontologies and controlled terminologies, enabling curators to map code list terms from multiple source systems to preferred ontology terms.","components":["WildFly 8.2+ app server","Hibernate ORM","Apache Lucene full-text index","Graphviz dot visualization","Relational database (Oracle primary; MySQL/PostgreSQL possible)","Maven WAR build","Optional Apache httpd reverse proxy"],"protocols":["RESTful HTTP (/ontologies)","OBO format 1.2 (PUT/GET)","OWL export (RDF/XML, OWL/XML, Manchester, Turtle)","AJP (proxy)","SMTP (notifications)","HTTP Basic Auth"],"measurement":["Curator audit trail","Version tracking","Peer review/approval workflow"],"modes":["Interactive web UI curation","REST API (OBO import, OWL/OBO/JSON export)","Batch ETL load","Automated synonym mapping"],"constraints":["PUT ingestion accepts OBO 1.2 only","Production validated on Oracle only; others need source changes","Graphviz must be installed locally","Auth is external (Apache Basic Auth)","No Docker"],"docker_services":[],"notable_absences":["No Docker","No SPARQL endpoint","No OWL import via API","No user management UI","No SKOS/FHIR support"],"configuration":[],"fault_injection":[]}