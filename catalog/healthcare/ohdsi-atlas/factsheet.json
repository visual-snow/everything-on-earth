{"slug":"ohdsi-atlas","name":"OHDSI/Atlas","what_it_is":"An open-source web frontend for the OHDSI research stack that lets epidemiologists define cohorts, run characterizations, incidence analyses, population-level estimation, and patient-level prediction against data in the OMOP CDM v5.","components":["Knockout.js MVVM frontend","OHDSI WebAPI (REST backend, separate repo)","CIRCE cohort expression engine","CYCLOPS estimation bridge","Feature Extraction layer","Patient-Level Prediction module","Nginx static server (Docker)","AtlasCharts D3 library","Concept Vocabulary search"],"protocols":["HTTP/HTTPS REST to WebAPI","OAuth2/OIDC (Google, GitHub, Facebook)","SAML 2.0","Kerberos","LDAP/AD","DB-local auth"],"measurement":["Cohort counts and attrition waterfall","Incidence rate analysis","Characterization distributions","Estimation effect estimates","Prediction AUROC and calibration"],"modes":["Unauthenticated open access","Authenticated with permissions","Dynamic WebAPI URL resolution","Execution-engine mode","Docker Nginx image"],"constraints":["Requires running OHDSI WebAPI","Data must be in OMOP CDM v5","Chrome only officially supported","R analyses execute server-side in WebAPI","No built-in TLS termination","No SQL-level cohort import"],"docker_services":["atlas (nginx)"],"notable_absences":["No ETL tooling","No FHIR/HL7 interface","No offline mode","No mobile layout"],"configuration":[],"fault_injection":[]}